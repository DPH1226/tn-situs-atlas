# Scheduled refresh job (Railway cron service): pull layers, run all 95 counties, rebuild site/.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git libgdal-dev gcc g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
CMD ["bash", "deploy/refresh.sh"]
